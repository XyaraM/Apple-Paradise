; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Apple Paradise"
run/main_scene="res://MainMenu/main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
boot_splash/image="res://AppleGame/Sprites/Apple.png"
config/icon="res://AppleGame/Sprites/Apple.png"

[autoload]

SaveSys="*res://SaveSys/SaveSys.gd"
ApPosition="*res://Variables/apposition.gd"
Signalmanager="*res://Variables/signalmanager.gd"
Variablemanager="*res://Variables/variablemanager.gd"
DialogueManager="*res://Open World/AppleWorld/Dialogue System/Scripts/DialogueManager.gd"
InteractionManager="*res://Open World/AppleWorld/Interaction System/InteractionManager.tscn"

[display]

window/stretch/mode="viewport"

[file_customization]

folder_colors={
"res://AppleGame/": "red",
"res://Open World/": "green"
}

